# Copy this file to server/.env (never commit .env)
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/vps
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173

# --- HTTPS (VPS-SR-003) - leave empty for local development ---
# NODE_ENV=production
# SSL_KEY_PATH=certs/key.pem
# SSL_CERT_PATH=certs/cert.pem
# HTTPS_PORT=5443
# TRUST_PROXY=true   (only when a hosting platform / reverse proxy handles HTTPS)
